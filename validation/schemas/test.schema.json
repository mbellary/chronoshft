{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChronosHFT test record v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^TST-[0-9]{3,}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "experiment": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^EXP-[0-9]{3,}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "additionalProperties": false
    },
    "hypothesis_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^HYP-[0-9]{3,}$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "classification": {
      "enum": [
        "correctness",
        "safety",
        "performance",
        "compatibility",
        "documentary",
        "reliability"
      ]
    },
    "execution_type": {
      "enum": [
        "automated",
        "manual"
      ]
    },
    "mandatory": {
      "type": "boolean"
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "procedure": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "expected": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "oracle": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "description"
      ],
      "additionalProperties": false
    },
    "execution_method": {
      "type": "string",
      "minLength": 1
    },
    "required_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "revision_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "actor": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "revision",
          "date",
          "actor",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "validations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^VAL-[0-9]{3,}$"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "id",
          "revision"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "execution_binding": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "unbound",
            "bound"
          ]
        },
        "implementation_path": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "entrypoint": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "state",
        "implementation_path",
        "entrypoint"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "id",
    "revision",
    "title",
    "experiment",
    "hypothesis_ids",
    "classification",
    "execution_type",
    "mandatory",
    "preconditions",
    "procedure",
    "expected",
    "oracle",
    "execution_method",
    "required_evidence",
    "revision_history",
    "validations",
    "execution_binding"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "execution_binding": {
            "properties": {
              "state": {
                "const": "unbound"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "execution_binding": {
            "properties": {
              "implementation_path": {
                "type": "null"
              },
              "entrypoint": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution_binding": {
            "properties": {
              "state": {
                "const": "bound"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "execution_binding": {
            "properties": {
              "entrypoint": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution_type": {
            "const": "automated"
          },
          "execution_binding": {
            "properties": {
              "state": {
                "const": "bound"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "execution_binding": {
            "properties": {
              "implementation_path": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
